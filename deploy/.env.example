# 部署环境变量模板
# ------------------------------------------------------------------
# 复制成 deploy/.env 后填入真实值，然后 chmod 600 deploy/.env
#   cp deploy/.env.example deploy/.env
# deploy/.env 不要提交到任何仓库。
#
# 下面的 python 脚本用 `from _sshutil import main` 读取它们：
#   ssh.py / put-dist.py / upload_tarot.py
# ------------------------------------------------------------------

# ---- 服务器 ----
# 注意：建议不要再直接用 root。建一个普通账号 + sudo，并把公钥装上去。
SW_HOST=your.server.ip.or.domain
SW_PORT=22
SW_USER=deploy
SW_SSH_KEY=~/.ssh/id_ed25519

# 仅在密钥不可用时才设置；设置后就不再走 ssh-agent / 默认密钥
# SW_PASSWORD=

# 首次连接、known_hosts 里还没有这台机器时临时设为 1，连上后改回 0
SW_ACCEPT_NEW_HOST_KEY=0

# ---- 备份 ----
# backup.sh 用的 MySQL 凭据文件（权限必须 600），不要在环境变量里放密码
MYSQL_DEFAULTS_FILE=~/.my.cnf
# BACKUP_DIR=/opt/starwhisper/backup
# BACKUP_DB=starwhisper
# BACKUP_KEEP_DAYS=7
